<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>com.labyrinthworm.trophyrefresh</string>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>-lc</string>
    <string>/Users/mattmini/Documents/GitHub/trophyhunting/tools/refresh.sh</string>
  </array>
  <!-- 07:30 daily. If the Mac is asleep then, launchd runs it at next wake. -->
  <key>StartCalendarInterval</key>
  <dict><key>Hour</key><integer>7</integer><key>Minute</key><integer>30</integer></dict>
  <key>RunAtLoad</key><false/>
  <key>StandardOutPath</key><string>/Users/mattmini/Documents/GitHub/trophyhunting/tools/.launchd.out.log</string>
  <key>StandardErrorPath</key><string>/Users/mattmini/Documents/GitHub/trophyhunting/tools/.launchd.err.log</string>
  <key>WorkingDirectory</key><string>/Users/mattmini/Documents/GitHub/trophyhunting</string>
</dict>
</plist>
